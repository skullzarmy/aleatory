# Copy to .env.local.
#
# Grouped by WHERE IT RUNS, because that is the thing that trips people up.
# Four places, and almost nothing is needed in more than one:
#
#   1. the website          Netlify site env
#   2. the provider daemon  a machine you keep running, not Netlify
#   3. deploying contracts  your terminal, once
#   4. local development    only ever your own machine
#
# Anything named NEXT_PUBLIC_ is readable by anyone with the page open, which
# is correct for all of them: they are public addresses and public hosts.


# =============================================================================
# 1. THE WEBSITE
# =============================================================================
# Set these in the Netlify site's environment. Everything except PINATA_JWT
# ships to the browser.

# shadownet | mainnet. Picks the TzKT indexer, the RPC, the explorer links, and
# which wallet network Beacon asks for. Also drives the network badge in the
# header, which is hidden on mainnet.
NEXT_PUBLIC_TEZOS_NETWORK=shadownet

# The only address you need. The router holds the current factory, marketplace,
# registry and resolver, plus every retired factory, so collections deployed by
# an old one stay visible. Empty means "nothing deployed on this network" and
# the UI says so rather than failing.
NEXT_PUBLIC_ROUTER_ADDRESS=

# Legacy overrides, from before the router existed. Leave them unset. If set,
# they win over what the router says, which is occasionally useful when testing
# a contract the router does not know about yet.
# NEXT_PUBLIC_FACTORY_ADDRESS=
# NEXT_PUBLIC_MARKETPLACE_ADDRESS=
# NEXT_PUBLIC_REGISTRY_ADDRESS=
# NEXT_PUBLIC_RESOLVER_ADDRESS=

# Where a minted piece runs for a viewer. Its own origin, always, because it
# executes code published by someone else. One isolate host can serve every
# network: it knows nothing about chains, it only runs what it is handed.
#
# This feeds the CSP's frame-src. Point it somewhere the isolate is not and
# every preview is an empty frame with no error to explain it.
#
#   npm run dev:isolate
#
NEXT_PUBLIC_ISOLATE_ORIGIN=http://localhost:4321

# This deployment's own public URL. Used for share links and Open Graph tags,
# so an unset value means shares point at production from a preview.
NEXT_PUBLIC_SITE_URL=

# Where ipfs:// resolves for viewers. fileship answers in about a fifth of a
# second where pinata takes four, which decides whether a feed looks loaded or
# looks broken. Whatever you set is added to img-src automatically.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.fileship.xyz

# Turns an address into a name: Tezos Domains reverse record, then a hack.tez
# subdomain, then the TzKT alias. Optional, and the default is the public one.
# Whatever is set here is added to connect-src, so a wrong value fails silently
# as addresses that never resolve to names. See docs/identity.md.
# NEXT_PUBLIC_HACKTEZ_API=https://hacktez.com

# --- server only, never NEXT_PUBLIC_ ---

# Pinning, for /api/pin. Without it the studio reports that pinning is
# unconfigured rather than failing at signature. An artist who would rather not
# use it can pin anywhere and paste an ipfs:// pointer into the deploy form.
PINATA_JWT=

# Shared secret for /api/render-ping, which lets a mint say "look now" instead
# of waiting for the daemon's next poll. Must match the daemon's copy. Polling
# works without it, so this only costs you a slower first reveal.
ALEA_PROVIDER_PING_TOKEN=


# =============================================================================
# 2. THE PROVIDER DAEMON
# =============================================================================
# Not Netlify. This is a process that stays up:
#
#   npm run provider:daemon
#
# It watches for pieces still holding their collection's pending document,
# renders them, pins the result, and writes the metadata. It refuses to start
# if any of the four below is missing rather than running half configured.

# Your provider contract. Collections point at this, and it is asked for the
# signing key live on every write, which is what makes key rotation work.
ALEA_PROVIDER_ADDRESS=

# The agent's secret key. Signs set_token_metadata and nothing else: it cannot
# pause a collection, move a token, change a price, or touch the provider
# contract's balance. Fund it with a few tez and no more. Generated by
#
#   npm run provider:setup -- --go
#
ALEA_AGENT_SK=

# Pinning, again. The daemon pins the images it renders.
# PINATA_JWT=

# Cloudflare Browser Run draws the images. The token needs the
# "Browser Rendering — Edit" permission and nothing else. CLOUDFLARE_ACCOUNT_ID
# and CLOUDFLARE_API_TOKEN are read too, since that is what Cloudflare's own
# tooling calls them.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Must match the website's copy, if you set one there.
# ALEA_PROVIDER_PING_TOKEN=

# How often to look when there is nothing to do. Default 15000.
# ALEA_POLL_MS=15000

# Overrides for the chain endpoints the daemon reads. Default to the network's
# public ones.
# TZKT_API=
# TEZOS_RPC=

# Where the daemon fetches a generator stored by pointer rather than on chain.
# ALEA_IPFS_GATEWAY=https://ipfs.fileship.xyz

# Collections this provider declines to serve, comma separated. Its own
# editorial choice, exactly like the site's blocklist, and it gates nothing:
# another provider can serve them.
# ALEA_BLOCKED_COLLECTIONS=

# Where the daemon looks for collections. Normally unset: it reads the factory
# list from the router, which holds the current factory and every retired one,
# so a collection deployed by an old factory keeps being served.
#
# Set only to override that, for testing against a factory the router does not
# list. An operator who sets one factory here serves that factory's collections
# and silently ignores every other, which is a thing you notice weeks later.
# ALEA_ROUTER_ADDRESS=
# ALEA_FACTORIES=
# ALEA_FACTORY_ADDRESS=


# =============================================================================
# 3. DEPLOYING CONTRACTS
# =============================================================================
# Your terminal, once per network:
#
#   npx tsx contract/deploy.ts
#
# Four separate keys, and the script refuses to run if any two are the same or
# if any of them is the deployer. See docs/audit-response.md for what the admin
# key actually holds before you decide where to keep it.

# Signs and pays for the originations, then holds nothing. A throwaway you fund
# for the run is the right shape.
TEZOS_WALLET_PRIV_KEY=

# The platform operator. admin_lambda over factory storage, fees, pause,
# resolver, and the router's contents. Cold key, or a multisig later:
# propose_admin/accept_admin moves it without redeploying anything.
ALEA_ADMIN_ADDRESS=

# Receives swept fees. Signs nothing, ever, so it can be colder than the admin
# key can ever be. Deliberately not defaulted to the admin: it was, and the
# shadownet deploy silently collapsed the two.
ALEA_TREASURY_ADDRESS=

# The agent, from provider:setup. Recorded in the provider contract.
ALEA_AGENT_ADDRESS=

# Marketplace cut of secondary sales, basis points. Default 250 (2.5%). The
# contract caps it at 1000 and a deployment above that is refused.
# ALEA_MARKET_FEE_BPS=250

# What an artist pays the factory to deploy a collection. Default 0.
# ALEA_DEPLOY_PRICE_MUTEZ=0

# How your provider presents itself in any UI that lists providers.
# Presentation only: none of it affects authorisation, price, or who may write.
# ALEA_PROVIDER_NAME=
# ALEA_PROVIDER_DESC=
# ALEA_PROVIDER_AVATAR=
# ALEA_PROVIDER_URL=


# --- deploying one collection from the terminal ---
#
#   npx tsx contract/deploy-collection.ts [--dry-run] [--buy]
#
# The artist path and the collector path, run once, to measure what a
# collection costs to deploy and what a mint costs on top. Everything above in
# section 3 applies, plus these. Not needed to run the site.

# The generator, already pinned. Both required.
# ALEA_CODE_URI=ipfs://
# ALEA_CODE_SHA256=

# The document every piece mints carrying, until a provider replaces it.
# ALEA_PENDING_METADATA=ipfs://QmPendingPlaceholder
# ALEA_COLLECTION_NAME=Aleatory Test Collection
# ALEA_EDITION_SIZE=10
# ALEA_PRICE_MUTEZ=1000000
# ALEA_ROYALTY_BPS=1000

# Whether resolver-authorised writers may publish metadata for this
# collection's unrevealed pieces. "true" is what lets a provider work without
# the artist configuring anything further.
# ALEA_TRUST_RESOLVER=false


# =============================================================================
# 4. LOCAL DEVELOPMENT
# =============================================================================

# Port for `npm run dev:isolate`. Must agree with NEXT_PUBLIC_ISOLATE_ORIGIN.
# ISOLATE_PORT=4321

# Set by `npm run provider:check`. Reports what is waiting and changes nothing.
# PROVIDER_DRY=1
