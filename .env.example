# Copy to .env.local. Everything NEXT_PUBLIC_ is readable by anyone with the
# page open, which is correct for all of it: these are public addresses.

NEXT_PUBLIC_TEZOS_NETWORK=shadownet

# From contract/deployments/shadownet.json, written by contract/deploy.ts.
# Empty means "nothing deployed yet" and the UI says so rather than failing.
NEXT_PUBLIC_FACTORY_ADDRESS=KT1NAwy9vbX2To48m1GJJ7qZMnkoXuuWExeR
NEXT_PUBLIC_MARKETPLACE_ADDRESS=KT1Rv1HHT7DAaCknT1vsn1gvb1AG3W7newPs
NEXT_PUBLIC_REGISTRY_ADDRESS=KT1GzMU3eEshwF2bgzqqbVku84YMGtJiSyLV
NEXT_PUBLIC_RESOLVER_ADDRESS=KT1KWZM6gwcSrff1w78RzrnXoXREdWSgMZsN

# The provider's render host, where a MINTED piece renders for a viewer. Its
# own origin because it executes code published by someone else, so this is
# never the app's own host. Production: isolate.aleatory.art
#
#   npm run dev:isolate
#
# Used by /piece/* and /collection/*, which frame a generator by CID. The
# studio does not go through it: a draft has no CID and is framed from srcdoc.
NEXT_PUBLIC_ISOLATE_ORIGIN=http://localhost:4321

# Turns an address into a name: Tezos Domains reverse record, then a hack.tez
# subdomain, then the TzKT alias. Optional. Unset uses the public resolver, and
# a resolver that never answers only means addresses stay truncated.
# Whatever is set here is added to connect-src, so a private one works too.
NEXT_PUBLIC_HACKTEZ_API=https://hacktez.com

# --- server only, never NEXT_PUBLIC_ ---

# Pinning, for /api/pin and the provider function. Without it, publishing
# reports that pinning is unconfigured rather than failing at signature.
PINATA_JWT=

# The provider function (netlify/functions/provider.mts). Needed only when
# running the render pipeline locally.
ALEA_AGENT_SK=
# How this provider presents itself in any UI that lists providers.
# Presentation only; none of it affects authorisation or price.
ALEA_PROVIDER_NAME=
ALEA_PROVIDER_DESC=
ALEA_PROVIDER_AVATAR=
ALEA_PROVIDER_ADDRESS=
# Cloudflare Browser Run, which draws the images. The token needs the
# "Browser Rendering — Edit" permission and nothing else.
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN are read too.
CF_ACCOUNT_ID=
CF_API_TOKEN=
ALEA_PROVIDER_PING_TOKEN=
ALEA_FACTORIES=
