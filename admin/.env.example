# Aleatory admin console.
#
# Every variable here is NEXT_PUBLIC because every one of them is a public
# chain address that ends up in the browser regardless. There is no secret in
# this app: it holds no key, and every privileged action is gated on chain by
# the address that signs it.

# Which chain. The controls look identical on both.
NEXT_PUBLIC_TEZOS_NETWORK=shadownet

# The router is the only one that has to be right. Everything the platform
# resolves to is read from it, including the live factory.
NEXT_PUBLIC_ROUTER_ADDRESS=

# Read from the router when set there. Fill these only to pin a specific one.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RESOLVER_ADDRESS=

# The render provider you operate. Not discoverable: the registry lists every
# provider and has no notion of which one is yours.
NEXT_PUBLIC_PROVIDER_ADDRESS=

# The daemon's working key, watched for balance only. This is the tz1 the
# provider contract names as its agent.
NEXT_PUBLIC_AGENT_ADDRESS=

# Warn below this. The daemon stops publishing silently when the key empties.
NEXT_PUBLIC_AGENT_LOW_WATER_MUTEZ=5000000
