node_modules/
dist/
.env
.env.*
# The example is the one that is meant to be read. Without this it matches
# `.env.*` and a checkout arrives with nothing documenting what to set.
!.env.example
contract/output*/
contract/__pycache__/
# SmartPy writes one directory per test scenario into the working directory,
# named after the scenario, so a suite run by hand scatters them wherever you
# were standing. `npm run test:contracts` sets SMARTPY_OUTPUT_DIR to keep them
# together, but nothing forces anyone to use it.
#
# So the top level is allow-listed instead. A new directory here is a
# deliberate act and adding a line is the cost of it; a directory that
# appeared on its own is litter and stays invisible.
contract/output/
/*/
!/.github/
!/admin/
!/bot/
!/contract/
!/docs/
!/isolate/
!/netlify/
!/public/
!/scripts/
!/src/
.DS_Store

# deploy scripts
.env
contract/build/

# next
.next/
next-env.d.ts
out/
tsconfig.tsbuildinfo

# Starter kits, assembled by scripts/build-templates.mts on prebuild.
# The templates they contain are the source and are tracked.
public/templates/*.zip

# Local Netlify folder
.netlify

# Security review, and the response to it. Kept locally, never published: it
# is a map of what was weak and when, and a public one is a public map.
/third-party-audit.md
/docs/audit-response.md
/docs/audit-ui.md
/docs/open-questions.md
/docs/decisions.md
/docs/roadmap.md
/docs/sitemap.md
/docs/lab-entry.md
/docs/pipeline.md
# Key material, whatever it gets called.
*-keys.txt
