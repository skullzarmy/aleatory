dist/
.env
.env.*
# The example is the one that is meant to be read. Without this it matches
# `.env.*` and a checkout arrives with nothing documenting what to set.
!.env.example
contract/output*/
contract/__pycache__/
# SmartPy writes one directory per test scenario into the working directory,
# named after the scenario, so a suite run by hand scatters them wherever you
# were standing. `npm run test:contracts` sets SMARTPY_OUTPUT_DIR to keep them
# together, but nothing forces anyone to use it.
#
# So the top level is allow-listed instead. A new directory here is a
# deliberate act and adding a line is the cost of it; a directory that
# appeared on its own is litter and stays invisible.
contract/output/
/*/
!/contract/
!/docs/
!/isolate/
!/netlify/
!/public/
!/scripts/
!/src/
.DS_Store

