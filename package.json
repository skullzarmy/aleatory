{
  "name": "aleatory",
  "version": "0.1.0",
  "private": true,
  "description": "Fully on-chain generative art on Tezos",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:contracts": "python3 contract/build.py",
    "test:contracts": "SMARTPY_OUTPUT_DIR=contract/output-aleatory python3 contract/tests_aleatory.py && SMARTPY_OUTPUT_DIR=contract/output-marketplace python3 contract/tests_marketplace.py && SMARTPY_OUTPUT_DIR=contract/output-integration python3 contract/tests_integration.py",
    "deploy": "npx tsx contract/deploy.ts",
    "deploy:collection": "npx tsx contract/deploy-collection.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@taquito/taquito": "^23.0.3",
    "@tezos-x/octez.connect-sdk": "^4.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.471.1",
    "next": "15.3.6",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@taquito/signer": "^21.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
