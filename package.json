{
  "name": "aleatory",
  "version": "0.1.0",
  "private": true,
  "description": "Fully on-chain generative art on Tezos",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:isolate": "node scripts/dev-isolate.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:contracts": "python3 contract/build.py",
    "test:contracts": "SMARTPY_OUTPUT_DIR=contract/output python3 contract/tests_aleatory.py && SMARTPY_OUTPUT_DIR=contract/output python3 contract/tests_marketplace.py && SMARTPY_OUTPUT_DIR=contract/output python3 contract/tests_integration.py",
    "deploy": "npx tsx contract/deploy.ts",
    "deploy:collection": "npx tsx contract/deploy-collection.ts",
    "test:metadata": "npx tsx src/lib/metadata.test.ts",
    "build:icons": "npx tsx scripts/build-icons.mts",
    "logo": "npx tsx scripts/logo-preview.mts",
    "test:studio": "npx tsx src/lib/studio.test.ts",
    "test": "npm run test:metadata && npm run test:studio",
    "provider:run": "npx tsx scripts/provider-run.mts",
    "provider:setup": "npx tsx scripts/provider-setup.mts",
    "provider:check": "PROVIDER_DRY=1 npx tsx scripts/provider-run.mts",
    "provider:retry": "npx tsx scripts/provider-retry.mts",
    "provider:daemon": "npx tsx scripts/provider-daemon.mts"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@taquito/taquito": "^25.0.0",
    "@tezos-x/octez.connect-sdk": "^5.0.3",
    "@uiw/react-codemirror": "^4.25.11",
    "blakejs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.471.1",
    "next": "^15.5.24",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@netlify/blobs": "^8.1.0",
    "@netlify/functions": "^6.0.0",
    "@netlify/plugin-nextjs": "^5.9.4",
    "@taquito/signer": "^25.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
