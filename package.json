{
    "name": "aleatory",
    "version": "0.1.0",
    "private": true,
    "license": "Unlicense",
    "description": "Fully on-chain generative art on Tezos",
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:all": "concurrently -k -n isolate,next -c magenta,cyan \"npm:dev:isolate\" \"npm:dev\"",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "build:contracts": "python3 contract/build.py",
        "test:contracts": "SMARTPY_OUTPUT_DIR=contract/output python3 contract/tests_aleatory.py && SMARTPY_OUTPUT_DIR=contract/output python3 contract/tests_marketplace.py && SMARTPY_OUTPUT_DIR=contract/output python3 contract/tests_integration.py",
        "deploy": "npx tsx contract/deploy.ts",
        "deploy:collection": "npx tsx contract/deploy-collection.ts",
        "test:metadata": "npx tsx provider/metadata.test.ts",
        "build:icons": "npx tsx scripts/build-icons.mts",
    "build:social": "npx tsx scripts/build-social.mts",
        "logo": "npx tsx scripts/logo-preview.mts",
        "dev:isolate": "node scripts/dev-isolate.mjs",
        "test:studio": "npx tsx src/lib/studio.test.ts",
        "test:hooks": "npx tsx src/lib/hooks.test.ts",
        "test": "npm run test:metadata && npm run test:studio && npm run test:hooks && npm run test:dep && npm run test:payable && npm run test:ping && npm run test:img && npm run test:stats && npm run test:conformance && npm run test:links && npm run test:logo && npm run test:refs && npm run test:brand && npm run test:contracts:docs",
        "provider:run": "npx tsx provider/run.mts",
        "provider:setup": "npx tsx provider/setup.mts",
        "provider:check": "npx tsx provider/run.mts --dry-run",
        "provider:retry": "npx tsx provider/retry.mts",
        "provider:daemon": "npx tsx provider/daemon.mts",
        "templates:build": "npx tsx scripts/build-templates.mts",
        "prebuild": "npx tsx scripts/build-templates.mts",
        "test:dep": "npx tsx src/lib/dep.test.ts",
        "test:conformance": "npx tsx src/lib/conformance.test.ts",
        "predev": "npx tsx scripts/build-templates.mts",
        "test:links": "node scripts/check-links.mjs",
        "test:logo": "npx tsx src/lib/logo.test.ts",
        "test:refs": "node scripts/check-refs.mjs",
        "test:brand": "npx tsx src/lib/brand.test.ts",
        "test:contracts:docs": "node scripts/check-contracts.mjs",
        "test:payable": "npx tsx src/lib/payable.test.ts",
        "test:stats": "npx tsx bot/stats.test.ts",
        "bot:daemon": "npx tsx bot/daemon.ts",
        "bot:run": "npx tsx bot/run.ts",
        "bot:check": "npx tsx bot/run.ts --dry-run",
        "bot:doctor": "npx tsx bot/doctor.ts",
        "test:ping": "npx tsx src/lib/ping.test.ts",
        "test:img": "npx tsx src/lib/img.test.ts"
    },
    "dependencies": {
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@icons-pack/react-simple-icons": "^13.15.1",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-slider": "^1.2.3",
        "@radix-ui/react-slot": "^1.1.1",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.1.7",
        "@taquito/taquito": "^25.0.0",
        "@tezos-x/octez.connect-sdk": "^5.0.3",
        "@uiw/react-codemirror": "^4.25.11",
        "blakejs": "^1.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fflate": "^0.8.2",
        "lucide-react": "^0.471.1",
        "next": "^15.5.24",
        "next-themes": "^0.4.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^2.6.0"
    },
    "devDependencies": {
        "@netlify/plugin-nextjs": "^5.9.4",
        "@taquito/signer": "^25.0.0",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.2.4",
        "dotenv": "^16.4.5",
        "postcss": "^8.5.1",
        "tailwindcss": "^3.4.1",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    },
    "engines": {
        "node": ">=18.18"
    }
}
